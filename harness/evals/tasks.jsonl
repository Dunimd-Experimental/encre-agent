{"id":"compaction-after-tool","category":"compaction","window":8192,"prompt":"Call big_output then report.","prompt_repeat":{"chunk":"payload ","times":8000},"script":[{"tools":[{"name":"big_output","arguments":{}}]},{"text":"big output survived"}],"expect":{"events_include":["CompactStarting","ToolCallStart","ToolResult"],"final_text_contains":["big output survived"],"tool_results_include":["BEGIN-"],"backend_calls":[2,10]}}
