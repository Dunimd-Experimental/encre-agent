# Encre Agent Harness — offline behaviour evals.
# Each line is one task consumed by run_evals.py.
#
# Task fields: id, category, prompt, prompt_repeat {chunk,times}, window,
#              supports_tools, script[], default_text, expect{}
# Script step: {"text": s} | {"text_repeat": {chunk,times,suffix}}
#              | {"tools": [{"id": s, "name": s, "arguments": {}, "arg_repeat": {field,chunk,times}}]}
#              | {"error": s, "retryable": bool, "code": s}
# Expect keys: final_text_contains[], final_text_not_contains[], tool_results_include[],
#              events_include[], events_exclude[], backend_calls [min,max],
#              min_text_len, finish_reason

{"id":"text-basic","category":"text","prompt":"Say the number 42.","script":[{"text":"The answer is 42."}],"expect":{"final_text_contains":["42"],"events_include":["TextDelta","Finish"],"backend_calls":[1,1],"finish_reason":"stop"}}
{"id":"text-unicode","category":"text","prompt":"Reply with an emoji and Chinese characters.","script":[{"text":"你好，世界 🌍 — done."}],"expect":{"final_text_contains":["🌍","你好"],"backend_calls":[1,1]}}
{"id":"text-empty-recovery","category":"text","prompt":"Give a one-word answer.","script":[{"text":""},{"text":"recovered"}],"expect":{"final_text_contains":["recovered"],"backend_calls":[2,3],"finish_reason":"stop"}}
{"id":"text-long","category":"text","prompt":"Write a long document and end it with END.","script":[{"text_repeat":{"chunk":"lorem ipsum dolor sit amet consectetur adipiscing elit ","times":1000,"suffix":"END"}}],"expect":{"final_text_contains":["END"],"min_text_len":10000,"backend_calls":[1,1]}}
{"id":"text-multiline","category":"text","prompt":"Show me a function.","script":[{"text":"```python\ndef add(a: int, b: int) -> int:\n    return a + b\n```"}],"expect":{"final_text_contains":["def add","return a + b"],"backend_calls":[1,1]}}
{"id":"text-no-tools","category":"text","supports_tools":false,"prompt":"Answer without tools.","script":[{"text":"Answered without any tool."}],"expect":{"final_text_contains":["without any tool"],"events_exclude":["ToolCallStart","ToolCallEnd"],"backend_calls":[1,1]}}
{"id":"tool-single","category":"tool","prompt":"Use the echo tool to say hi.","script":[{"tools":[{"name":"echo","arguments":{"text":"hi"}}]},{"text":"tool said hi"}],"expect":{"tool_results_include":["echo:hi"],"events_include":["ToolCallStart","ToolResult","ToolCallEnd"],"final_text_contains":["tool said hi"],"backend_calls":[2,2]}}
{"id":"tool-two-turns","category":"tool","prompt":"Echo a then echo b.","script":[{"tools":[{"name":"echo","arguments":{"text":"a"}}]},{"tools":[{"name":"echo","arguments":{"text":"b"}}]},{"text":"both echoed"}],"expect":{"tool_results_include":["echo:a","echo:b"],"final_text_contains":["both echoed"],"backend_calls":[3,4]}}
{"id":"tool-parallel","category":"tool","prompt":"Echo a and b in parallel.","script":[{"tools":[{"id":"call_p1","name":"echo","arguments":{"text":"a"}},{"id":"call_p2","name":"echo","arguments":{"text":"b"}}]},{"text":"parallel done"}],"expect":{"tool_results_include":["echo:a","echo:b"],"final_text_contains":["parallel done"],"backend_calls":[2,2]}}
{"id":"tool-unknown","category":"tool","prompt":"Call the tool nope.","script":[{"tools":[{"name":"nope","arguments":{}}]},{"text":"after unknown tool"}],"expect":{"tool_results_include":["Unknown tool"],"final_text_contains":["after unknown tool"],"backend_calls":[2,3]}}
{"id":"tool-raises","category":"tool","prompt":"Call boom.","script":[{"tools":[{"name":"boom","arguments":{}}]},{"text":"after boom"}],"expect":{"tool_results_include":["tool exploded"],"final_text_contains":["after boom"],"backend_calls":[2,3]}}
{"id":"tool-bad-args","category":"tool","prompt":"Call strict_echo without arguments.","script":[{"tools":[{"name":"strict_echo","arguments":{}}]},{"text":"after invalid args"}],"expect":{"events_include":["ToolResult"],"final_text_contains":["after invalid args"],"backend_calls":[2,3]}}
{"id":"tool-big-output","category":"tool","prompt":"Call big_output.","script":[{"tools":[{"name":"big_output","arguments":{}}]},{"text":"big output received"}],"expect":{"tool_results_include":["BEGIN-","-END"],"final_text_contains":["big output received"],"backend_calls":[2,3]}}
{"id":"recovery-retryable-error","category":"recovery","prompt":"Return the phrase after error.","script":[{"error":"temporary upstream failure","retryable":true},{"text":"after error"}],"expect":{"final_text_contains":["after error"],"backend_calls":[2,3],"finish_reason":"stop"}}
{"id":"recovery-nonretryable-error","category":"recovery","prompt":"Return the phrase survived.","script":[{"error":"bad request body","retryable":false,"code":"invalid_request"},{"text":"survived"}],"expect":{"final_text_contains":["survived"],"backend_calls":[1,3]}}
{"id":"recovery-tool-then-empty","category":"recovery","prompt":"Echo x then finish.","script":[{"tools":[{"name":"echo","arguments":{"text":"x"}}]},{"text":""},{"text":"after empty"}],"expect":{"final_text_contains":["after empty"],"tool_results_include":["echo:x"],"backend_calls":[3,4]}}
{"id":"recovery-tool-error-then-tool","category":"recovery","prompt":"Call boom, then echo ok.","script":[{"tools":[{"name":"boom","arguments":{}}]},{"tools":[{"name":"echo","arguments":{"text":"ok"}}]},{"text":"recovered"}],"expect":{"tool_results_include":["tool exploded","echo:ok"],"final_text_contains":["recovered"],"backend_calls":[3,4]}}
